---
// Questions and answers, with matching FAQPage structured data.
interface Props {
  faqs: readonly { q: string; a: string }[];
  heading?: string;
}
const { faqs, heading = 'Common questions' } = Astro.props;
const schema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
---
{faqs.length > 0 && (
  <section class="faq">
    <h2>{heading}</h2>
    {faqs.map((f) => (
      <details>
        <summary>{f.q}</summary>
        <p>{f.a}</p>
      </details>
    ))}
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  </section>
)}

<style>
  .faq { max-width: 48rem; }
  details { border-top: 1px solid var(--color-border); }
  details:last-of-type { border-bottom: 1px solid var(--color-border); }
  summary {
    cursor: pointer; list-style: none; position: relative;
    padding: var(--space-4) var(--space-12) var(--space-4) 0; font-weight: 700; font-size: var(--text-lg);
  }
  summary::-webkit-details-marker { display: none; }
  summary::after {
    content: ''; position: absolute; right: var(--space-2); top: 50%; width: 12px; height: 12px; translate: 0 -75%;
    border-right: 3px solid var(--color-accent); border-bottom: 3px solid var(--color-accent); rotate: 45deg; transition: rotate 200ms;
  }
  details[open] summary::after { rotate: 225deg; translate: 0 -25%; }
  details p { margin: 0 0 var(--space-6); color: var(--color-ink-muted); max-width: 42rem; }
  @media (prefers-reduced-motion: reduce) { summary::after { transition: none; } }
</style>
