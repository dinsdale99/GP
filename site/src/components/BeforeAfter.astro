---
// Before/after for a job: the after photo fills the frame, the before photo sits inset in the corner.
// Tapping the inset swaps them (crossfade). No dragging, so a thumb never covers the photo.
// Without JS it simply shows the after photo with the before inset.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  before: ImageMetadata;
  after: ImageMetadata;
  label: string; // what the job is, used in alt text
  eager?: boolean;
  sizes?: string;
  focus?: string; // CSS object-position shared by both photos so the pair lines up
  class?: string;
}

const { before, after, label, eager = false, sizes = '100vw', focus = '50% 50%', class: className } = Astro.props;
const loading = eager ? 'eager' : 'lazy';
const widths = [480, 800, 1200, 1600];
---
<figure class:list={['ba', className]} data-ba data-showing="after" style={`--focus: ${focus}`}>
  <div class="main">
    <Image src={after} alt={`After: ${label}`} widths={widths} sizes={sizes} loading={loading} fetchpriority={eager ? 'high' : 'auto'} class="img img-after" />
    <Image src={before} alt={`Before: ${label}`} widths={widths} sizes={sizes} loading="lazy" class="img img-before" />
    <span class="tag" aria-hidden="true"><span class="t-after">After</span><span class="t-before">Before</span></span>
  </div>
  <button type="button" class="inset" aria-pressed="false" aria-label={`Show the before photo: ${label}`}>
    <Image src={before} alt="" width={480} class="thumb thumb-before" />
    <Image src={after} alt="" width={480} loading="lazy" class="thumb thumb-after" />
    <span class="inset-label"><span class="t-before">Before</span><span class="t-after">After</span><span class="hint">Tap to see</span></span>
  </button>
</figure>

<style>
  .ba { position: relative; margin: 0; overflow: hidden; background: var(--color-surface); }
  .main { position: absolute; inset: 0; }
  .ba :global(.img) {
    position: absolute; inset: 0; width: 100%; height: 100%;
    object-fit: cover; object-position: var(--focus); transition: opacity 350ms ease;
  }
  .ba :global(.img-before) { opacity: 0; }
  .ba[data-showing='before'] :global(.img-before) { opacity: 1; }

  .tag {
    position: absolute; top: var(--space-3); right: var(--space-3); padding: 0.15rem 0.6rem;
    background: rgb(10 10 10 / 0.78); color: #fff; font-size: var(--text-sm); font-weight: 600; border-radius: var(--radius);
  }

  /* The inset is the control: big enough to see the before and to tap easily */
  .inset {
    position: absolute; left: var(--space-3); bottom: var(--space-3); z-index: 1;
    width: clamp(120px, 28%, 300px); aspect-ratio: 4 / 3; padding: 0; overflow: hidden; cursor: pointer;
    border: 3px solid #fff; border-radius: var(--radius); background: #fff;
    box-shadow: 0 4px 16px rgb(0 0 0 / 0.35);
  }
  .inset :global(.thumb) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transition: opacity 350ms ease; }
  .inset :global(.thumb-after) { opacity: 0; }
  .ba[data-showing='before'] .inset :global(.thumb-after) { opacity: 1; }
  .inset-label {
    position: absolute; left: 0; right: 0; bottom: 0; display: flex; justify-content: space-between; gap: var(--space-2);
    padding: 0.2rem 0.5rem; background: rgb(10 10 10 / 0.8); color: #fff; font-size: 0.8125rem; font-weight: 700; text-align: left;
  }
  .hint { font-weight: 400; color: var(--color-on-dark-muted); }
  .inset:hover { border-color: var(--color-accent); }
  .inset:focus-visible { outline: 3px solid var(--color-accent); outline-offset: 2px; }

  /* Which word shows in the tag and the inset label */
  .t-before { display: none; }
  .ba[data-showing='before'] .tag .t-after,
  .ba[data-showing='before'] .inset-label .t-before { display: none; }
  .ba[data-showing='before'] .tag .t-before,
  .ba[data-showing='before'] .inset-label .t-after { display: inline; }
  .inset-label .t-before { display: inline; }
  .inset-label .t-after { display: none; }

  @media (max-width: 599px) { .inset { width: 40%; } }
  @media (prefers-reduced-motion: reduce) { .ba :global(.img), .inset :global(.thumb) { transition: none; } }
</style>

<script>
  for (const el of document.querySelectorAll<HTMLElement>('[data-ba]')) {
    const button = el.querySelector<HTMLButtonElement>('.inset')!;
    const label = button.getAttribute('aria-label')!.replace(/^Show the before photo: /, '');
    button.addEventListener('click', () => {
      const showingBefore = el.dataset.showing === 'before';
      el.dataset.showing = showingBefore ? 'after' : 'before';
      button.setAttribute('aria-pressed', String(!showingBefore));
      button.setAttribute('aria-label', `${showingBefore ? 'Show the before photo' : 'Show the after photo'}: ${label}`);
    });
  }
</script>
