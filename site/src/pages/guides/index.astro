---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import QuoteBand from '../../components/QuoteBand.astro';
import { business } from '../../data/business';

const guides = (await getCollection('guides', (g) => !g.data.draft)).sort((a, b) => +b.data.updated - +a.data.updated);
const groups = [
  { key: 'residential', title: 'Home and garden' },
  { key: 'commercial', title: 'Construction sites' },
] as const;
---
<BaseLayout title="Guides and Calculators" description={`Practical guides and calculators for fencing, garden measuring, protected trees and BS 5837 root protection areas, from ${business.name}.`}>
  <section class="container head">
    <h1>Guides and calculators</h1>
    <p class="lede">Measure up, check the rules and plan the job before you ask for a quote.</p>
  </section>
  {groups.map((g) => {
    const list = guides.filter((x) => x.data.category === g.key);
    return list.length > 0 && (
      <section class="container group">
        <h2>{g.title}</h2>
        <div class="grid">
          {list.map((x) => (
            <a href={`/guides/${x.id}/`}>
              <h3>{x.data.title}</h3>
              <p>{x.data.description}</p>
            </a>
          ))}
        </div>
      </section>
    );
  })}
  <QuoteBand />
</BaseLayout>

<style>
  .head { padding: var(--space-12) 0 var(--space-4); }
  .lede { color: var(--color-ink-muted); font-size: var(--text-lg); }
  .group { padding: var(--space-8) 0; }
  .group:last-of-type { padding-bottom: var(--space-16); }
  .grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-6); }
  .grid a { display: block; padding: var(--space-6); background: var(--color-surface); border-top: 4px solid var(--color-ink); border-radius: var(--radius); text-decoration: none; }
  .grid a:hover { border-top-color: var(--color-accent); }
  .grid h3 { font-size: var(--text-xl); margin-bottom: var(--space-2); }
  .grid p { margin: 0; color: var(--color-ink-muted); }
  @media (max-width: 899px) { .grid { grid-template-columns: 1fr; } }
</style>
