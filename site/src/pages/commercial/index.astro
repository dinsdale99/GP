---
import { getEntry } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import FAQ from '../../components/FAQ.astro';
import QuoteBand from '../../components/QuoteBand.astro';
import { business, services, whatsappLink } from '../../data/business';

const commercial = services.filter((s) => s.audience === 'commercial');
const caseStudy = (await getEntry('projects', 'development-site-clearance-tree-protection'))!;
const faqs = commercial.flatMap((s) => s.faqs).slice(0, 5);
const mail = `mailto:${business.email}?subject=${encodeURIComponent('Site enquiry: tree protection / hoarding')}`;
---
<BaseLayout
  title={`Tree Protection Fencing, Site Hoarding and Clearance for Contractors in ${business.region}`}
  description={`BS 5837 tree protection fencing, corrugated steel site hoarding and site clearance across ${business.region}, from a team that also does the tree work.`}
>
  <section class="top">
    <div class="container top-inner">
      <div>
        <nav class="crumbs" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><span>Construction sites</span></nav>
        <h1>Tree protection, hoarding and clearance for construction sites</h1>
        <p class="lede">
          Most sites need a fencing contractor for the tree protection and a tree surgeon for the agreed tree work.
          We are both, so one team sets out the protection, does the pruning, clears the site and takes it all down at the end.
        </p>
        <div class="actions">
          <a href={`tel:${business.phoneE164}`} class="btn btn-accent" data-track="click_call">Call {business.phone}</a>
          <a href={mail} class="btn btn-outline" data-track="click_email">Email the tree protection plan</a>
        </div>
      </div>
      <div class="top-media">
        <Image src={caseStudy.data.gallery[0].src} alt={caseStudy.data.gallery[0].alt} widths={[480, 800, 1200]} sizes="(min-width: 900px) 45vw, 100vw" loading="eager" />
      </div>
    </div>
  </section>

  <section class="container services">
    {commercial.map((s) => (
      <a href={s.path} class="service">
        <h2>{s.title}</h2>
        <p>{s.intro.split('. ')[0]}.</p>
        <span class="more">More about {s.label.toLowerCase()}</span>
      </a>
    ))}
  </section>

  <section class="process">
    <div class="container">
      <h2>How we work on site</h2>
      <ol>
        <li><h3>Send us the plans</h3><p>Tree protection plan, arboricultural method statement or site layout. A photo and a postcode will do to start.</p></li>
        <li><h3>Price and programme</h3><p>We price the fencing, hoarding and any agreed tree work together, and fit in with your start date.</p></li>
        <li><h3>Protection up first</h3><p>Fencing goes in to the plan before machines arrive, ready for the consultant or council to check.</p></li>
        <li><h3>Down at the end</h3><p>Once the protection can come down, we remove it and finish any remaining tree work.</p></li>
      </ol>
    </div>
  </section>

  <section class="container case">
    <div class="case-text">
      <h2>{caseStudy.data.title}</h2>
      <p>{caseStudy.data.summary}</p>
      <a href={`/projects/${caseStudy.id}/`} class="btn btn-outline">See the photos</a>
    </div>
    <div class="case-photos">
      {caseStudy.data.gallery.slice(1, 4).map((g) => (
        <Image src={g.src} alt={g.alt} widths={[400, 700]} sizes="(min-width: 900px) 20vw, 33vw" />
      ))}
    </div>
  </section>

  <section class="container consultants">
    <div>
      <h2>For arboricultural consultants</h2>
      <p>We install to your drawings and specification, photograph the finished protection, and can carry out the tree work in your method statement. If your clients ask who can do the job, we're happy to be on your list.</p>
    </div>
    <a href="/guides/root-protection-area-calculator/" class="calc">
      <h3>Root protection area calculator</h3>
      <p>Work out an RPA from stem diameter, including multi-stemmed trees, using the BS 5837:2012 method.</p>
    </a>
  </section>

  <section class="container faq-wrap">
    <FAQ faqs={faqs} />
  </section>

  <QuoteBand
    heading="Send us the drawings"
    text="Tree protection plan, method statement or a site photo: send what you have and we will price it."
    whatsappText={`Hi ${business.name}, I'd like a price for a site.`}
  />
</BaseLayout>

<style>
  .top { background: var(--color-brand); color: #fff; }
  .top-inner { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-12); align-items: center; padding: var(--space-12) 0; }
  .crumbs { display: flex; gap: var(--space-2); margin-bottom: var(--space-6); font-size: var(--text-sm); color: var(--color-on-dark-muted); }
  .crumbs a { font-weight: 600; }
  .lede { color: var(--color-on-dark-muted); font-size: var(--text-lg); line-height: 1.5; max-width: 38rem; }
  .actions { display: flex; flex-wrap: wrap; gap: var(--space-3); margin-top: var(--space-6); }
  .top-media { aspect-ratio: 4 / 3; overflow: hidden; border-radius: var(--radius); }
  .top-media :global(img) { width: 100%; height: 100%; object-fit: cover; }

  .services { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-6); padding: var(--space-16) 0; }
  .service { display: flex; flex-direction: column; padding: var(--space-6); border-top: 4px solid var(--color-ink); background: var(--color-surface); border-radius: var(--radius); text-decoration: none; }
  .service:hover { border-top-color: var(--color-accent); }
  .service h2 { font-size: var(--text-xl); }
  .service p { color: var(--color-ink-muted); flex: 1; }
  .more { font-weight: 700; text-decoration: underline; text-decoration-color: var(--color-accent); text-decoration-thickness: 2px; text-underline-offset: 3px; }

  .process { background: var(--color-surface); padding: var(--space-16) 0; }
  .process ol { list-style: none; counter-reset: step; display: grid; grid-template-columns: repeat(4, 1fr); gap: var(--space-8); margin: var(--space-8) 0 0; padding: 0; }
  .process li { counter-increment: step; border-top: 3px solid var(--color-ink); padding-top: var(--space-4); }
  .process li::before { content: counter(step); display: block; color: var(--color-accent); font-weight: 800; font-stretch: 75%; font-size: var(--text-2xl); line-height: 1; margin-bottom: var(--space-3); }
  .process p { color: var(--color-ink-muted); }

  .case { display: grid; grid-template-columns: 1fr 2fr; gap: var(--space-12); align-items: center; padding: var(--space-16) 0; }
  .case-text p { color: var(--color-ink-muted); }
  .case-photos { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-3); }
  .case-photos :global(img) { width: 100%; aspect-ratio: 3 / 4; object-fit: cover; border-radius: var(--radius); }

  .consultants { display: grid; grid-template-columns: 3fr 2fr; gap: var(--space-12); align-items: center; padding: var(--space-8) 0 var(--space-16); border-top: 1px solid var(--color-border); }
  .consultants p { color: var(--color-ink-muted); max-width: 40rem; }
  .calc { display: block; padding: var(--space-6); background: var(--color-brand); color: #fff; border-radius: var(--radius); text-decoration: none; border-left: 6px solid var(--color-accent); }
  .calc p { color: var(--color-on-dark-muted); margin: 0; }
  .calc h3 { font-size: var(--text-xl); margin-bottom: var(--space-2); }

  .faq-wrap { padding-bottom: var(--space-16); }

  @media (max-width: 899px) {
    .top-inner, .services, .case, .consultants { grid-template-columns: 1fr; }
    .process ol { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 559px) { .process ol { grid-template-columns: 1fr; } }
</style>
