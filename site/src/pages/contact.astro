---
import BaseLayout from '../layouts/BaseLayout.astro';
import QuoteForm from '../components/QuoteForm.astro';
import { business, whatsappLink } from '../data/business';

const days = (d: readonly string[]) => (d.length > 1 ? `${d[0]} to ${d.at(-1)}` : d[0]);
---
<BaseLayout title="Get a Quote" description={`Get a quote from ${business.name} for tree surgery, fencing, tree protection or site clearance in ${business.region}. Send photos by WhatsApp or use the form.`}>
  <section class="container page">
    <div class="main">
      <h1>Get a quote</h1>
      <p class="lede">Tell us about the job and add a few photos. We'll come back with a price, or arrange to come and look if we need to.</p>
      <QuoteForm />
    </div>
    <aside>
      <div class="box dark">
        <h2>Quickest: WhatsApp</h2>
        <p>Send photos and your postcode straight from your phone.</p>
        <a href={whatsappLink()} class="btn btn-accent" data-track="click_whatsapp" rel="noopener">WhatsApp us</a>
      </div>
      <div class="box">
        <h2>Call or email</h2>
        <p><a href={`tel:${business.phoneE164}`} data-track="click_call" class="big">{business.phone}</a></p>
        <p><a href={`mailto:${business.email}`} data-track="click_email">{business.email}</a></p>
        <dl>
          {business.hours.map((h) => (<><dt>{days(h.days)}</dt><dd>{h.opens} to {h.closes}</dd></>))}
        </dl>
      </div>
      <div class="box">
        <h2>Where we work</h2>
        <p>{business.areasServed.join(', ')} and the towns in between, across {business.region}.</p>
      </div>
    </aside>
  </section>
</BaseLayout>

<style>
  .page { display: grid; grid-template-columns: 3fr 2fr; gap: var(--space-12); padding: var(--space-12) 0 var(--space-16); align-items: start; }
  .lede { color: var(--color-ink-muted); font-size: var(--text-lg); max-width: 36rem; margin-bottom: var(--space-8); }
  aside { display: grid; gap: var(--space-4); }
  .box { background: var(--color-surface); border-radius: var(--radius); padding: var(--space-6); }
  .box.dark { background: var(--color-brand); color: #fff; }
  .box.dark p { color: var(--color-on-dark-muted); }
  .box h2 { font-size: var(--text-xl); margin-bottom: var(--space-2); }
  .big { font-weight: 800; font-stretch: 75%; font-size: var(--text-2xl); text-decoration: none; }
  dl { display: grid; grid-template-columns: auto 1fr; gap: var(--space-1) var(--space-4); margin: var(--space-4) 0 0; font-size: var(--text-sm); }
  dt { font-weight: 600; }
  dd { margin: 0; color: var(--color-ink-muted); }
  @media (max-width: 899px) { .page { grid-template-columns: 1fr; } }
</style>
