---
import { getCollection, getEntry } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import BeforeAfter from '../components/BeforeAfter.astro';
import ProjectCard from '../components/ProjectCard.astro';
import TrustStrip from '../components/TrustStrip.astro';
import Reviews from '../components/Reviews.astro';
import QuoteBand from '../components/QuoteBand.astro';
import { business, services, whatsappLink } from '../data/business';

const hero = (await getEntry('projects', 'roadside-clearance-boundary-fence'))!;
const homeJob = (await getEntry('projects', 'family-garden-fence-and-shed'))!;
const siteJob = (await getEntry('projects', 'development-site-clearance-tree-protection'))!;
const bandJob = (await getEntry('projects', 'overgrown-plot-clearance-fencing'))!;

const all = await getCollection('projects', (p) => !p.data.draft);
const featured = all.filter((p) => p.data.featured).slice(0, 6);
const guides = (await getCollection('guides', (g) => !g.data.draft)).slice(0, 3);

const wa = whatsappLink(`Hi ${business.name}, I'd like a quote. Here are some photos:`);
const tel = `tel:${business.phoneE164}`;
const residential = services.filter((s) => s.audience === 'residential');
const commercial = services.filter((s) => s.audience === 'commercial');
---
<BaseLayout
  title={`Tree Surgery, Fencing and Site Clearance in ${business.region}`}
  description={`${business.name}: tree surgery, garden fencing, BS 5837 tree protection fencing, site hoarding and clearance across ${business.region}. Send a photo for a price.`}
>
  <section class="hero">
    <BeforeAfter
      before={hero.data.pairs[0].before}
      after={hero.data.pairs[0].after}
      focus={hero.data.pairs[0].focus}
      label={hero.data.title}
      eager
      sizes="(min-width: 900px) 60vw, 100vw"
      class="hero-ba"
    />
    <div class="hero-panel">
      <h1>Tree work and fencing across {business.region}</h1>
      <p class="lede">From an overgrown garden to a fenced-off building site, one team does the clearing, the tree work and the fence. Send us a photo and we'll come back with a price.</p>
      <div class="hero-actions">
        <a href={wa} class="btn btn-accent" data-track="click_whatsapp" rel="noopener">WhatsApp us a photo</a>
        <a href={tel} class="btn btn-outline" data-track="click_call">Call {business.phone}</a>
      </div>
      <p class="areas">Working across {business.areasServed.slice(0, -1).join(', ')} and {business.areasServed.at(-1)}.</p>
    </div>
    <p class="hero-caption">Drag to compare: <a href={`/projects/${hero.id}/`}>{hero.data.title.toLowerCase()}</a></p>
  </section>

  <TrustStrip />

  <section class="paths">
    <div class="path path-home">
      <div class="path-media">
        <Image src={homeJob.data.pairs[0].after} alt={`After: ${homeJob.data.title}`} widths={[480, 800, 1200]} sizes="(min-width: 900px) 50vw, 100vw" />
      </div>
      <div class="path-body">
        <h2>Home and garden</h2>
        <p>Trees that have got too big, fences that have blown down, gardens nobody can get into. We sort all of it.</p>
        <ul>
          {residential.map((s) => <li><a href={s.path}>{s.title}</a></li>)}
          <li><a href="/projects/?service=site-clearance">Overgrown garden clearance</a></li>
        </ul>
      </div>
    </div>

    <div class="path path-sites">
      <div class="path-media">
        <Image src={siteJob.data.gallery[0].src} alt={siteJob.data.gallery[0].alt} widths={[480, 800, 1200]} sizes="(min-width: 900px) 50vw, 100vw" />
      </div>
      <div class="path-body">
        <h2>Construction sites</h2>
        <p>Tree protection, hoarding and clearance from the team that also does the tree work: one contractor from the first visit to taking the fencing down.</p>
        <ul>
          {commercial.map((s) => <li><a href={s.path}>{s.title}</a></li>)}
          <li><a href="/commercial/">How we work with contractors</a></li>
        </ul>
      </div>
    </div>
  </section>

  <section class="work container">
    <div class="section-head">
      <h2>Recent jobs</h2>
      <a href="/projects/" class="btn btn-outline">See all {all.length} jobs</a>
    </div>
    <p class="muted prose">Every photo here is our own work, taken before we started and after we finished.</p>
    <div class="grid">
      {featured.map((p) => <ProjectCard project={p} />)}
    </div>
  </section>

  <section class="band" aria-label="Clearance work">
    <Image src={bandJob.data.pairs[1].before} alt={`Before: ${bandJob.data.title}`} widths={[800, 1400, 2000]} sizes="100vw" class="band-img" />
    <div class="band-text container">
      <h2>No job too overgrown</h2>
      <p>Brambles, scrub, rubble and self-seeded trees cleared with mini diggers where the job needs it, then fenced so it stays that way.</p>
      <a href={`/projects/${bandJob.id}/`} class="btn btn-white">See this clearance job</a>
    </div>
  </section>

  <Reviews />

  <section class="steps-wrap">
    <div class="container">
      <h2>Getting a price</h2>
      <ol class="steps">
        <li>
          <h3>Send us a photo</h3>
          <p>WhatsApp a few photos of the trees, fence or site, with your postcode. Or use the <a href="/contact/">quote form</a>.</p>
        </li>
        <li>
          <h3>We give you a price</h3>
          <p>If we need a closer look, we'll come out and measure up first.</p>
        </li>
        <li>
          <h3>We do the job and clear up</h3>
          <p>You get before and after photos of the finished work.</p>
        </li>
      </ol>
    </div>
  </section>

  {guides.length > 0 && (
    <section class="plan container">
      <div class="section-head">
        <h2>Plan your job</h2>
        <a href="/guides/" class="btn btn-outline">All guides</a>
      </div>
      <div class="plan-grid">
        {guides.map((g) => (
          <a href={`/guides/${g.id}/`} class="plan-card">
            <h3>{g.data.title}</h3>
            <p>{g.data.description}</p>
          </a>
        ))}
      </div>
    </section>
  )}

  <QuoteBand />
</BaseLayout>

<style>
  /* Hero: the before/after is the page's one big moment */
  .hero { position: relative; display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); }
  .hero :global(.hero-ba) { grid-column: 2; grid-row: 1; height: min(calc(100svh - 72px), 780px); min-height: 480px; }
  .hero-panel {
    grid-column: 1; grid-row: 1; align-self: center;
    padding: var(--space-12) var(--space-8) var(--space-12) max(var(--space-4), calc((100vw - var(--content-width)) / 2));
  }
  .lede { color: var(--color-ink-muted); font-size: var(--text-lg); line-height: 1.5; }
  .hero-actions { display: flex; flex-wrap: wrap; gap: var(--space-3); margin-top: var(--space-6); }
  .areas { margin: var(--space-6) 0 0; padding-top: var(--space-4); border-top: 1px solid var(--color-border); color: var(--color-ink-muted); font-size: var(--text-sm); }
  .hero-caption {
    position: absolute; right: var(--space-4); bottom: var(--space-4); margin: 0;
    color: #fff; font-size: var(--text-sm); text-shadow: 0 1px 3px rgb(0 0 0 / 0.8);
  }

  /* Two audiences, two halves */
  .paths { display: grid; grid-template-columns: 1fr 1fr; }
  .path { display: grid; grid-template-rows: auto 1fr; }
  .path-media { aspect-ratio: 16 / 9; overflow: hidden; }
  .path-media :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .path-body { padding: var(--space-12) max(var(--space-4), 6%); }
  .path-body > p { max-width: 34rem; font-size: var(--text-lg); line-height: 1.5; }
  .path ul { margin: var(--space-6) 0 0; padding: 0; list-style: none; }
  .path li { border-top: 1px solid var(--color-border); }
  .path li a {
    display: flex; justify-content: space-between; align-items: center; gap: var(--space-4);
    padding: var(--space-3) 0; font-weight: 700; font-size: var(--text-lg); text-decoration: none;
  }
  .path li a::after {
    content: ''; width: 9px; height: 9px; flex: none;
    border-top: 3px solid var(--color-accent); border-right: 3px solid var(--color-accent); rotate: 45deg;
  }
  .path li a:hover { color: var(--color-accent); }
  .path-home { background: var(--color-surface); }
  .path-home .path-body > p { color: var(--color-ink-muted); }
  .path-sites { background: var(--color-brand); color: #fff; }
  .path-sites .path-body > p { color: var(--color-on-dark-muted); }
  .path-sites li { border-color: #2c2e2c; }

  .section-head { display: flex; justify-content: space-between; align-items: end; gap: var(--space-4); flex-wrap: wrap; }
  .section-head h2 { margin: 0; }

  /* Jobs */
  .work { padding: var(--space-24) 0 var(--space-16); }
  .work > .muted { margin-top: var(--space-3); }
  .grid { display: grid; gap: var(--space-12) var(--space-6); grid-template-columns: repeat(3, 1fr); margin-top: var(--space-8); }

  /* Full-bleed photo band */
  .band { position: relative; min-height: 520px; display: grid; align-items: end; color: #fff; overflow: hidden; }
  .band :global(.band-img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .band::after { content: ''; position: absolute; inset: 0; background: linear-gradient(to top, rgb(10 10 10 / 0.85) 0%, rgb(10 10 10 / 0.35) 55%, rgb(10 10 10 / 0) 100%); }
  .band-text { position: relative; z-index: 1; padding: var(--space-16) 0; }
  .band-text h2 { font-size: var(--text-3xl); max-width: 14ch; }
  .band-text p { max-width: 36rem; font-size: var(--text-lg); line-height: 1.5; color: #e6e7e4; }
  .btn-white { background: #fff; color: var(--color-ink); margin-top: var(--space-2); }
  .btn-white:hover { background: var(--color-surface); }

  /* Steps: a real sequence, so numbered */
  .steps-wrap { padding: var(--space-16) 0; }
  .steps { list-style: none; counter-reset: step; display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-8); margin: var(--space-8) 0 0; padding: 0; }
  .steps li { counter-increment: step; }
  .steps li::before {
    content: counter(step); display: grid; place-items: center; width: 44px; height: 44px; margin-bottom: var(--space-4);
    border-radius: 50%; border: 3px solid var(--color-accent); color: var(--color-accent);
    font-weight: 800; font-size: var(--text-lg);
  }
  .steps p { color: var(--color-ink-muted); max-width: 22rem; }

  /* Guides */
  .plan { padding: var(--space-8) 0 var(--space-16); }
  .plan-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-6); margin-top: var(--space-8); }
  .plan-card {
    display: block; padding: var(--space-6); background: var(--color-surface); border-radius: var(--radius);
    border-top: 4px solid var(--color-ink); text-decoration: none;
  }
  .plan-card:hover { border-top-color: var(--color-accent); }
  .plan-card h3 { font-size: var(--text-lg); margin-bottom: var(--space-2); }
  .plan-card p { margin: 0; color: var(--color-ink-muted); font-size: var(--text-sm); }

  @media (max-width: 899px) {
    .hero { grid-template-columns: 1fr; }
    .hero :global(.hero-ba) { grid-column: 1; height: 58svh; min-height: 320px; }
    .hero-panel { grid-column: 1; grid-row: 2; padding: var(--space-8) var(--space-4); }
    .hero-caption { display: none; }
    .paths { grid-template-columns: 1fr; }
    .grid { grid-template-columns: 1fr 1fr; }
    .steps, .plan-grid { grid-template-columns: 1fr; gap: var(--space-6); }
  }
  @media (max-width: 767px) {
    .path-body { padding: var(--space-8) var(--space-4); }
    .work { padding-top: var(--space-16); }
    .band { min-height: 440px; }
  }
  @media (max-width: 559px) { .grid { grid-template-columns: 1fr; } }
</style>
